# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mercado_scraper
DB_USER=root
DB_PASSWORD=troque_aqui
DB_CONNECTION_LIMIT=5

# URLs dos catálogos
NAGUMO_BASE_URL=https://www.nagumo.com.br
COOP_BASE_URL=https://www.coopsupermercado.com.br
SONDA_BASE_URL=https://www.sondadelivery.com.br
JOANIN_BASE_URL=https://www.joaninonline.com.br
CARREFOUR_BASE_URL=https://mercado.carrefour.com.br
ASSAI_BASE_URL=https://www.assai.com.br
SUPERABC_BASE_URL=https://superabconline.com.br

# Execução e Performance
HEADLESS=true
USE_API_COLLECTORS=true
HTTP_CONCURRENCY=12
BROWSER_CONCURRENCY=3
BATCH_SIZE=200
REQUEST_DELAY_MS=500
PAGE_SETTLE_MS=1000
NAVIGATION_TIMEOUT_MS=45000
MAX_PAGES_PER_SOURCE=600
MAX_SITEMAP_URLS=1000
COOP_PAGE_SETTLE_MS=1000
SONDA_PAGE_SETTLE_MS=2000
SUPERABC_PAGE_SETTLE_MS=2000
SAVE_PRICE_HISTORY=true
LOG_LEVEL=info

