ASSAI_BASE_URL=https://www.assai.com.br
SUPERABC_BASE_URL=https://superabconline.com.br

# Execução
HEADLESS=true
REQUEST_DELAY_MS=1200
PAGE_SETTLE_MS=1500
MAX_CONCURRENCY=2
MAX_PAGES_PER_SOURCE=500
SAVE_PRICE_HISTORY=true
LOG_LEVEL=info
